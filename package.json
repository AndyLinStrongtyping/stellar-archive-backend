{
  "name": "stellar-archive-backend",
  "version": "1.0.0",
  "description": "Stellar Archive REST API for catalog, authentication, favorites and admin workflows",
  "main": "server.js",
  "scripts": {
    "start": "npm run migration:run && node server.js",
    "dev":"docker compose up -d --wait && node server.js",
    "stop": "docker compose stop",
    "sql": "node db/seed_data.js",
    "migration:create": "typeorm migration:create -o",
    "migration:generate": "typeorm migration:generate -d db/typeorm/data-source.js -o",
    "migration:show": "typeorm migration:show -d db/typeorm/data-source.js",
    "migration:run": "typeorm migration:run -d db/typeorm/data-source.js",
    "migration:revert": "typeorm migration:revert -d db/typeorm/data-source.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "typeorm": "^1.1.0"
  }
}
